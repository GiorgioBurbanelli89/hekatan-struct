$ File saved Paz_13_1.e2k
$ Hekatan Struct - benchmark Paz Ejemplo 13.1 (Space Frame 3D)

$ PROGRAM INFORMATION
  PROGRAM  "ETABS"  VERSION "19.1.0"

$ CONTROLS
  UNITS  "TONF"  "M"  "C"
  TITLE1  "Paz 13.1 Space Frame"
  TITLE2  "Hekatan Struct - benchmark"

$ STORIES - IN SEQUENCE FROM TOP
  STORY "Story2"  HEIGHT 5.08 MASTERSTORY "Yes"
  STORY "Story1"  HEIGHT 5.08 SIMILARTO "Story2"
  STORY "Base"    ELEV -5.08

$ GRIDS
  GRIDSYSTEM "G1"  TYPE "CARTESIAN"  BUBBLESIZE 1.25

$ DIAPHRAGM NAMES
  DIAPHRAGM "D1"    TYPE RIGID

$ MATERIAL PROPERTIES
  MATERIAL "STEEL"  TYPE "Steel"  GRADE "Grade 50"  WEIGHTPERVOLUME 7.85
  MATERIAL "STEEL"  SYMTYPE "Isotropic"  E 21093744  U 0.25  A 1.17E-05
  MATERIAL "STEEL"  FY 35153  FU 45699  FYE 38668  FUE 50269

$ FRAME SECTIONS
  FRAMESECTION "SEC1"  MATERIAL "STEEL"  SHAPE "Concrete Rectangular"  D 0.18 B 0.18
  FRAMESECTION "SEC2"  MATERIAL "STEEL"  SHAPE "Concrete Rectangular"  D 0.135 B 0.135

$ POINT COORDINATES
  POINT "1"  0       0
  POINT "2"  0       5.08
  POINT "3"  -5.08   0

$ LINE CONNECTIVITIES
  LINE "E1"  BEAM    "1"  "2"  0
  LINE "E2"  COLUMN  "1"  "1"  1
  LINE "E3"  BEAM    "1"  "3"  0
  LINE "E4"  COLUMN  "1"  "1"  1

$ POINT ASSIGNS
  POINTASSIGN "2"  "Story1"  RESTRAINT "UX UY UZ RX RY RZ"  DIAPH "DISCONNECTED"
  POINTASSIGN "3"  "Story1"  RESTRAINT "UX UY UZ RX RY RZ"  DIAPH "DISCONNECTED"
  POINTASSIGN "1"  "Story2"  RESTRAINT "UX UY UZ RX RY RZ"  DIAPH "DISCONNECTED"
  POINTASSIGN "1"  "Base"    RESTRAINT "UX UY UZ RX RY RZ"  DIAPH "DISCONNECTED"

$ LINE ASSIGNS
  LINEASSIGN "E1"  "Story1"  SECTION "SEC1"  RIGIDZONE 0.5 MAXSTASPC 0.1 MINNUMSTA 3 AUTOMESH "YES" MESHATINTERSECTIONS "YES"
  LINEASSIGN "E2"  "Story2"  SECTION "SEC2"  RIGIDZONE 0.5 MAXSTASPC 0.1 MINNUMSTA 3 AUTOMESH "YES" MESHATINTERSECTIONS "YES"
  LINEASSIGN "E3"  "Story1"  SECTION "SEC1"  RIGIDZONE 0.5 MAXSTASPC 0.1 MINNUMSTA 3 AUTOMESH "YES" MESHATINTERSECTIONS "YES"
  LINEASSIGN "E4"  "Story1"  SECTION "SEC2"  RIGIDZONE 0.5 MAXSTASPC 0.1 MINNUMSTA 3 AUTOMESH "YES" MESHATINTERSECTIONS "YES"

$ LOAD PATTERNS
  LOADPATTERN "DEAD"  TYPE "Dead"   SELFWEIGHT 1
  LOADPATTERN "USER"  TYPE "Other"  SELFWEIGHT 0

$ POINT OBJECT LOADS
  POINTLOAD "1"  "Story1"  TYPE "FORCE"  LC "USER"  FX 0 FY -2.268 FZ 0

$ ANALYSIS OPTIONS
  ACTIVEDOF  "UX UY UZ RX RY RZ"

$ MASS SOURCE
  MASSSOURCE "MsSrc1"  INCLUDEELEMENTS "Yes"  INCLUDEADDEDMASS "No"  INCLUDELOADS "No"  LUMPATSTORIES "Yes"  ISDEFAULT "Yes"

$ LOAD CASES
  LOADCASE "Modal"  TYPE  "Modal - Eigen"  INITCOND  "PRESET"
  LOADCASE "Modal"  MAXMODES  6  MINMODES  1  EIGENSHIFTFREQ  0  EIGENCUTOFF  0  EIGENTOL  1E-09
  LOADCASE "Dead"   TYPE  "Linear Static"  INITCOND  "PRESET"
  LOADCASE "Dead"   LOADPAT  "DEAD"  SF  1
  LOADCASE "User"   TYPE  "Linear Static"  INITCOND  "PRESET"
  LOADCASE "User"   LOADPAT  "USER"  SF  1

  END
$ END OF MODEL FILE
