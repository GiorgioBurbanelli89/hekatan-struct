# --- carga de las AREAS entregada a las vigas, EN UN SENTIDO
#     El deck y el zinc no entran a la matriz: solo entregan
#     su carga a las vigas que los sostienen, como una
#     membrana en ETABS. Va como carga REPARTIDA (frameload,
#     kN/m), no como fuerzas en los nudos: repartir a nudos
#     por ancho tributario supone tramos simplemente apoyados
#     e ignora que la vigueta es CONTINUA sobre las
#     principales (medido: 16 % de menos en el apoyo interior
#     del vano ancho y 23 % de mas en el extremo).
frameload 395 0 0 -0.431112
