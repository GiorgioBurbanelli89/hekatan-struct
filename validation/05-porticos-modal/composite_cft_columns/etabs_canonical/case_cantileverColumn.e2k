$ canonical case: cantileverColumn

$ PROGRAM INFORMATION
  PROGRAM  "ETABS"  VERSION "22.6.0"

$ CONTROLS
  UNITS  "KN"  "M"  "C"  
  TITLE2  "Canonical (cantileverColumn)"

$ STORIES - IN SEQUENCE FROM TOP
  STORY "Level_2"  HEIGHT 4  MASTERSTORY "Yes"  
  STORY "Base"  ELEV 0

$ GRIDS
  GRIDSYSTEM "G1"  TYPE "CARTESIAN"  BUBBLESIZE 1
  GRID "G1"  LABEL "A"  DIR "X"  COORD 0  VISIBLE "Yes"  BUBBLELOC "End"
  GRID "G1"  LABEL "1"  DIR "Y"  COORD 0  VISIBLE "Yes"  BUBBLELOC "Start"

$ MATERIAL PROPERTIES
  MATERIAL  "Mat_2"    TYPE "Steel"    WEIGHTPERVOLUME 7.85
  MATERIAL  "Mat_2"    SYMTYPE "Isotropic"  E 200000000  U 0.3  A 1E-05
  MATERIAL  "Mat_2"    FY 345000  FU 450000  EFFFY 379500  EFFFU 495000

$ FRAME SECTIONS
  FRAMESECTION  "W360X60"  MATERIAL "Mat_2"  SHAPE "Steel I/Wide Flange"  D 0.352  B 0.203  TF 0.013  TW 0.008

$ POINT COORDINATES
  POINT "1"  0 0

$ LINE CONNECTIVITIES
  LINE  "C1"  COLUMN  "1"  "1"  1

$ POINT ASSIGNS
  POINTASSIGN  "1"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"  
  POINTASSIGN  "1"  "Level_2"  

$ LINE ASSIGNS
  LINEASSIGN  "C1"  "Level_2"  SECTION "W360X60"  MINNUMSTA 3 AUTOMESH "YES"  

$ LOAD PATTERNS
  LOADPATTERN "Live"  TYPE  "Live"  SELFWEIGHT  0

$ POINT OBJECT LOADS
  POINTLOAD  "1"  "Level_2"  LC "Live"  TYPE "FORCE"  FX 10 FY 0 FZ 0 MX 0 MY 0 MZ 0

$ ANALYSIS OPTIONS
  ACTIVEDOF "UX UY UZ RX RY RZ"
  PDELTA  METHOD "NONE"

$ LOAD CASES
  LOADCASE "Live"  TYPE  "Linear Static"  INITCOND  "PRESET"
  LOADCASE "Live"  LOADPAT  "Live"  SF  1

  END
$ END OF MODEL FILE