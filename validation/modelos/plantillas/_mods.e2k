$ File   "Hekatan_export.e2k"  saved 8/27/2026  13:41:55 in ETABS 22.6.0

$ PROGRAM INFORMATION
  PROGRAM  "ETABS"  VERSION "22.6.0"  

$ CONTROLS
  UNITS  "N"  "MM"  "C"  
  TITLE1  "Hekatan Struct Lineal export"  
  TITLE2  "losa con modificadores"  
  PREFERENCE  MERGETOL 0.001
  RLLF  METHOD "ASCE7-10"  USEDEFAULTMIN "YES"  

$ GRIDS
  GRIDSYSTEM "G1"  TYPE "CARTESIAN"  BUBBLESIZE 1.25 
  GRID "G1"  LABEL "A"  DIR "X"  COORD 0  GRIDTYPE "PRIMARY"  BUBBLELOC "DEFAULT"  GRIDHIDE "NO"  
  GRID "G1"  LABEL "B"  DIR "X"  COORD 4  GRIDTYPE "PRIMARY"  BUBBLELOC "DEFAULT"  GRIDHIDE "NO"  
  GRID "G1"  LABEL "1"  DIR "Y"  COORD 0  GRIDTYPE "PRIMARY"  BUBBLELOC "DEFAULT"  GRIDHIDE "NO"  
  GRID "G1"  LABEL "2"  DIR "Y"  COORD 4  GRIDTYPE "PRIMARY"  BUBBLELOC "DEFAULT"  GRIDHIDE "NO"  

$ STORIES - IN SEQUENCE FROM TOP
  STORY "Base"  ELEV 3 

$ DIAPHRAGM NAMES
  DIAPHRAGM "D1"    TYPE RIGID

$ MATERIAL PROPERTIES
  MATERIAL  "Conc_1"    TYPE "Concrete"    WEIGHTPERVOLUME 0.00002353596
  MATERIAL  "Conc_1"    SYMTYPE "Isotropic"  E 20000  U 0.2  A 0.00001
  MATERIAL  "Conc_1"    FC 24

$ FRAME SECTIONS

$ POINT COORDINATES
  POINT "1"  0 0 
  POINT "2"  4000 0 
  POINT "3"  4000 4000 
  POINT "4"  0 4000 

$ LINE CONNECTIVITIES

$ POINT ASSIGNS
  POINTASSIGN  "1"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"  DIAPH "DISCONNECTED"  
  POINTASSIGN  "2"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"  DIAPH "DISCONNECTED"  
  POINTASSIGN  "3"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"  DIAPH "DISCONNECTED"  
  POINTASSIGN  "4"  "Base"  RESTRAINT "UX UY UZ RX RY RZ"  DIAPH "DISCONNECTED"  

$ LINE ASSIGNS

$ SLAB PROPERTIES
  SHELLPROP  "Losa"  PROPTYPE  "Slab"  MATERIAL "Conc_1"  MODELINGTYPE "ShellThin"  SLABTYPE "Slab"  SLABTHICKNESS 200 
  SHELLPROP  "Losa"  F11MOD 0.7 F22MOD 0.8 F12MOD 0.9 M11MOD 0.25 M22MOD 0.35 M12MOD 0.45 V13MOD 0.6 V23MOD 0.5 

$ AREA CONNECTIVITIES
  AREA "F1"  FLOOR  4  "1"  "2"  "3"  "4"  0  0  0  0  

$ AREA ASSIGNS
  AREAASSIGN  "F1"  "Base"  SECTION "Losa"  DIAPH  "D1"  OBJMESHTYPE "DEFAULT"  ADDRESTRAINT "Yes"  CARDINALPOINT "TOP"  TRANSFORMSTIFFNESSFOROFFSETS "No"  

$ LOAD PATTERNS
  LOADPATTERN "Dead"  TYPE  "Dead"  SELFWEIGHT  0
  LOADPATTERN "Live"  TYPE  "Live"  SELFWEIGHT  0

$ ANALYSIS OPTIONS
  ACTIVEDOF "UX UY UZ RX RY RZ"  
  PDELTA  METHOD "NONE"  

$ MASS SOURCE
  MASSSOURCE  "MsSrc1"    INCLUDEELEMENTS "Yes"    INCLUDEADDEDMASS "No"    INCLUDELOADS "No"    INCLUDEMOVE "No"    INCLUDELATERALMASS "Yes"    INCLUDEVERTICALMASS "No"    LUMPATSTORIES "Yes"    ISDEFAULT "Yes"  

$ LOAD CASES
  LOADCASE "Dead"  TYPE  "Linear Static"  INITCOND  "PRESET"  
  LOADCASE "Dead"  LOADPAT  "Dead"  SF 1 
  LOADCASE "Live"  TYPE  "Linear Static"  INITCOND  "PRESET"  
  LOADCASE "Live"  LOADPAT  "Live"  SF 1 
  LOADCASE "Modal"  TYPE  "Modal - Eigen"  INITCOND  "PRESET"  
  LOADCASE "Modal"  MAXMODES 3  MINMODES 1  EIGENSHIFTFREQ 0  EIGENCUTOFFFREQ 0  EIGENTOL 1E-09  ALLOWAUTOFREQSHIFT "Yes"  

  END
$ END OF MODEL FILE