$ Barra axial 1D — cantilever vertical (configuracion validada via API)
$ hekatan-struct "Barra axial (1D)" default params adaptados a ETABS:
$   L = 5 m (vertical, eje Z), A = 0.01 m^2 (10x10 cm), E = 200 GPa
$   F = +100 kN axial (FZ en extremo superior)
$ Restraint: joint "1" en story Base = empotramiento 6 DOFs
$ Joint "1" en story Level_1 = extremo libre (cantilever)
$ Esperado analitico (Hooke 1D): delta = F*L/(A*E) = 2.5e-4 m = 0.25 mm
$ Validado via API: 0.250000 mm exacto, FZ_reaccion=-100 kN

$ PROGRAM INFORMATION
  PROGRAM  "ETABS"  VERSION "22.6.0"

$ CONTROLS
  UNITS  "KN"  "M"  "C"
  TITLE2  "Hekatan Barra Axial 1D - cantilever vertical"

$ STORIES - IN SEQUENCE FROM TOP
  STORY "Level_1"  HEIGHT 5  MASTERSTORY "Yes"
  STORY "Base"  ELEV 0

$ GRIDS
  GRIDSYSTEM "G1"  TYPE "CARTESIAN"  BUBBLESIZE 1
  GRID "G1"  LABEL "A"  DIR "X"  COORD 0  VISIBLE "Yes"  BUBBLELOC "End"
  GRID "G1"  LABEL "1"  DIR "Y"  COORD 0  VISIBLE "Yes"  BUBBLELOC "Start"

$ MATERIAL PROPERTIES
  MATERIAL  "S200"    TYPE "Steel"    WEIGHTPERVOLUME 78
  MATERIAL  "S200"    SYMTYPE "Isotropic"  E 200000000  U 0.3  A 1.17E-05
  MATERIAL  "S200"    FY 345000  FU 450000  EFFFY 379500  EFFFU 495000

$ FRAME SECTIONS
  FRAMESECTION  "BAR10x10"  MATERIAL "S200"  SHAPE "Concrete Rectangular"  D 0.1  B 0.1

$ POINT COORDINATES
  POINT "1"  0 0

$ LINE CONNECTIVITIES
  LINE  "C1"  COLUMN  "1"  "1"  1

$ POINT ASSIGNS
  POINTASSIGN  "1"  "Base"      RESTRAINT "UX UY UZ RX RY RZ"
  POINTASSIGN  "1"  "Level_1"

$ LINE ASSIGNS
  LINEASSIGN  "C1"  "Level_1"  SECTION "BAR10x10"  MINNUMSTA 3 AUTOMESH "YES"

$ LOAD PATTERNS
  LOADPATTERN "AXIAL"  TYPE  "Other"  SELFWEIGHT  0

$ POINT OBJECT LOADS
  POINTLOAD  "1"  "Level_1"  LC "AXIAL"  TYPE "FORCE"  FX 0 FY 0 FZ 100 MX 0 MY 0 MZ 0

$ ANALYSIS OPTIONS
  ACTIVEDOF "UX UY UZ RX RY RZ"
  PDELTA  METHOD "NONE"

$ LOAD CASES
  LOADCASE "AXIAL"  TYPE  "Linear Static"  INITCOND  "PRESET"
  LOADCASE "AXIAL"  LOADPAT  "AXIAL"  SF  1

  END
$ END OF MODEL FILE
