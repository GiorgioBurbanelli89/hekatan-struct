$ File "composite_slab_thick_frame.e2k" saved on 2026-05-07
$ ETABS .e2k - Benchmark losa cuadrada 4x4 m con 16 vigas perimetrales y 4 pin-supports en esquinas
$ Variante: SHELL THICK (Mindlin-Reissner)
$ Modelo equivalente al MATLAB composite_slab_thin_frame.m
$
$ PROGRAM INFORMATION
  PROGRAM  "ETABS"  VERSION "19.0.0"

$ CONTROLS
  UNITS  "KN"  "M"  "C"
  TITLE1  "Composite slab thin + frames"

$ STORIES - IN SEQUENCE FROM TOP
  STORY "Slab"  HEIGHT 4  MASTERSTORY "Yes"
  STORY "Base"  ELEV 0

$ GRIDS
  GRIDSYSTEM "G1" TYPE "Cartesian" BUBBLESIZE 1
  GRID "G1" GRIDID "X1" GRIDTYPE "X" GRIDCOORD 0
  GRID "G1" GRIDID "X2" GRIDTYPE "X" GRIDCOORD 1
  GRID "G1" GRIDID "X3" GRIDTYPE "X" GRIDCOORD 2
  GRID "G1" GRIDID "X4" GRIDTYPE "X" GRIDCOORD 3
  GRID "G1" GRIDID "X5" GRIDTYPE "X" GRIDCOORD 4
  GRID "G1" GRIDID "Y1" GRIDTYPE "Y" GRIDCOORD 0
  GRID "G1" GRIDID "Y2" GRIDTYPE "Y" GRIDCOORD 1
  GRID "G1" GRIDID "Y3" GRIDTYPE "Y" GRIDCOORD 2
  GRID "G1" GRIDID "Y4" GRIDTYPE "Y" GRIDCOORD 3
  GRID "G1" GRIDID "Y5" GRIDTYPE "Y" GRIDCOORD 4

$ MATERIAL PROPERTIES
  MATERIAL "C25"   TYPE "Concrete"  E 25000000  U 0.20  WEIGHTPERVOLUME 0
  MATERIAL "A992Fy50" TYPE "Steel"  E 200000000 U 0.30  WEIGHTPERVOLUME 0

$ FRAME SECTIONS - usando catalogo W360X60 (alma vertical, eje fuerte horizontal)
  FRAMESECTION "W360X60" MATERIAL "A992Fy50" SHAPE "I-Section" \
    D 0.352 B 0.203 TF 0.013 TW 0.008

$ SLAB SECTIONS
  SHELLPROP "S100T" PROPTYPE "Slab" MATERIAL "C25" MODELINGTYPE "ShellThick" \
    SLABTYPE "Slab" SLABTHICKNESS 0.10

$ POINT COORDINATES (z=0 plano losa, 5x5 = 25 nodos)
  POINT "1"  0 0
  POINT "2"  1 0
  POINT "3"  2 0
  POINT "4"  3 0
  POINT "5"  4 0
  POINT "6"  0 1
  POINT "7"  1 1
  POINT "8"  2 1
  POINT "9"  3 1
  POINT "10" 4 1
  POINT "11" 0 2
  POINT "12" 1 2
  POINT "13" 2 2
  POINT "14" 3 2
  POINT "15" 4 2
  POINT "16" 0 3
  POINT "17" 1 3
  POINT "18" 2 3
  POINT "19" 3 3
  POINT "20" 4 3
  POINT "21" 0 4
  POINT "22" 1 4
  POINT "23" 2 4
  POINT "24" 3 4
  POINT "25" 4 4

$ LINE CONNECTIVITIES (16 frames perimetrales)
  LINE "B1"  FRAME "1"  "2"  0
  LINE "B2"  FRAME "2"  "3"  0
  LINE "B3"  FRAME "3"  "4"  0
  LINE "B4"  FRAME "4"  "5"  0
  LINE "B5"  FRAME "21" "22" 0
  LINE "B6"  FRAME "22" "23" 0
  LINE "B7"  FRAME "23" "24" 0
  LINE "B8"  FRAME "24" "25" 0
  LINE "B9"  FRAME "1"  "6"  0
  LINE "B10" FRAME "6"  "11" 0
  LINE "B11" FRAME "11" "16" 0
  LINE "B12" FRAME "16" "21" 0
  LINE "B13" FRAME "5"  "10" 0
  LINE "B14" FRAME "10" "15" 0
  LINE "B15" FRAME "15" "20" 0
  LINE "B16" FRAME "20" "25" 0

$ AREA CONNECTIVITIES (16 Q4 shells)
  AREA "S1"  SHELL "1"  "2"  "7"  "6"  4
  AREA "S2"  SHELL "2"  "3"  "8"  "7"  4
  AREA "S3"  SHELL "3"  "4"  "9"  "8"  4
  AREA "S4"  SHELL "4"  "5"  "10" "9"  4
  AREA "S5"  SHELL "6"  "7"  "12" "11" 4
  AREA "S6"  SHELL "7"  "8"  "13" "12" 4
  AREA "S7"  SHELL "8"  "9"  "14" "13" 4
  AREA "S8"  SHELL "9"  "10" "15" "14" 4
  AREA "S9"  SHELL "11" "12" "17" "16" 4
  AREA "S10" SHELL "12" "13" "18" "17" 4
  AREA "S11" SHELL "13" "14" "19" "18" 4
  AREA "S12" SHELL "14" "15" "20" "19" 4
  AREA "S13" SHELL "16" "17" "22" "21" 4
  AREA "S14" SHELL "17" "18" "23" "22" 4
  AREA "S15" SHELL "18" "19" "24" "23" 4
  AREA "S16" SHELL "19" "20" "25" "24" 4

$ RESTRAINTS - 4 esquinas pinned (UX UY UZ, rotaciones libres)
  POINTASSIGN "1"  "Slab" RESTRAINT "UX UY UZ"
  POINTASSIGN "5"  "Slab" RESTRAINT "UX UY UZ"
  POINTASSIGN "21" "Slab" RESTRAINT "UX UY UZ"
  POINTASSIGN "25" "Slab" RESTRAINT "UX UY UZ"

$ FRAME ASSIGNMENTS
  LINEASSIGN "B1"  "Slab" SECTION "W360X60"
  LINEASSIGN "B2"  "Slab" SECTION "W360X60"
  LINEASSIGN "B3"  "Slab" SECTION "W360X60"
  LINEASSIGN "B4"  "Slab" SECTION "W360X60"
  LINEASSIGN "B5"  "Slab" SECTION "W360X60"
  LINEASSIGN "B6"  "Slab" SECTION "W360X60"
  LINEASSIGN "B7"  "Slab" SECTION "W360X60"
  LINEASSIGN "B8"  "Slab" SECTION "W360X60"
  LINEASSIGN "B9"  "Slab" SECTION "W360X60"
  LINEASSIGN "B10" "Slab" SECTION "W360X60"
  LINEASSIGN "B11" "Slab" SECTION "W360X60"
  LINEASSIGN "B12" "Slab" SECTION "W360X60"
  LINEASSIGN "B13" "Slab" SECTION "W360X60"
  LINEASSIGN "B14" "Slab" SECTION "W360X60"
  LINEASSIGN "B15" "Slab" SECTION "W360X60"
  LINEASSIGN "B16" "Slab" SECTION "W360X60"

$ SHELL ASSIGNMENTS
  AREAASSIGN "S1"  "Slab" SECTION "S100T"
  AREAASSIGN "S2"  "Slab" SECTION "S100T"
  AREAASSIGN "S3"  "Slab" SECTION "S100T"
  AREAASSIGN "S4"  "Slab" SECTION "S100T"
  AREAASSIGN "S5"  "Slab" SECTION "S100T"
  AREAASSIGN "S6"  "Slab" SECTION "S100T"
  AREAASSIGN "S7"  "Slab" SECTION "S100T"
  AREAASSIGN "S8"  "Slab" SECTION "S100T"
  AREAASSIGN "S9"  "Slab" SECTION "S100T"
  AREAASSIGN "S10" "Slab" SECTION "S100T"
  AREAASSIGN "S11" "Slab" SECTION "S100T"
  AREAASSIGN "S12" "Slab" SECTION "S100T"
  AREAASSIGN "S13" "Slab" SECTION "S100T"
  AREAASSIGN "S14" "Slab" SECTION "S100T"
  AREAASSIGN "S15" "Slab" SECTION "S100T"
  AREAASSIGN "S16" "Slab" SECTION "S100T"

$ LOAD PATTERNS
  LOADPATTERN "DEAD" TYPE "Dead" SELFWEIGHT 0

$ AREA UNIFORM LOADS - q = 5 kN/m^2 hacia abajo (Gravity)
  AREALOAD "S1"  "Slab" TYPE "Uniform" DIR "Gravity" LC "DEAD" FVAL 5
  AREALOAD "S2"  "Slab" TYPE "Uniform" DIR "Gravity" LC "DEAD" FVAL 5
  AREALOAD "S3"  "Slab" TYPE "Uniform" DIR "Gravity" LC "DEAD" FVAL 5
  AREALOAD "S4"  "Slab" TYPE "Uniform" DIR "Gravity" LC "DEAD" FVAL 5
  AREALOAD "S5"  "Slab" TYPE "Uniform" DIR "Gravity" LC "DEAD" FVAL 5
  AREALOAD "S6"  "Slab" TYPE "Uniform" DIR "Gravity" LC "DEAD" FVAL 5
  AREALOAD "S7"  "Slab" TYPE "Uniform" DIR "Gravity" LC "DEAD" FVAL 5
  AREALOAD "S8"  "Slab" TYPE "Uniform" DIR "Gravity" LC "DEAD" FVAL 5
  AREALOAD "S9"  "Slab" TYPE "Uniform" DIR "Gravity" LC "DEAD" FVAL 5
  AREALOAD "S10" "Slab" TYPE "Uniform" DIR "Gravity" LC "DEAD" FVAL 5
  AREALOAD "S11" "Slab" TYPE "Uniform" DIR "Gravity" LC "DEAD" FVAL 5
  AREALOAD "S12" "Slab" TYPE "Uniform" DIR "Gravity" LC "DEAD" FVAL 5
  AREALOAD "S13" "Slab" TYPE "Uniform" DIR "Gravity" LC "DEAD" FVAL 5
  AREALOAD "S14" "Slab" TYPE "Uniform" DIR "Gravity" LC "DEAD" FVAL 5
  AREALOAD "S15" "Slab" TYPE "Uniform" DIR "Gravity" LC "DEAD" FVAL 5
  AREALOAD "S16" "Slab" TYPE "Uniform" DIR "Gravity" LC "DEAD" FVAL 5

$ LOAD CASE / ANALYSIS
  LOADCASE "DEAD" TYPE "Linear Static" INITCOND "PRESET" DESIGNTYPE "DEAD"
  LOADCASE "DEAD" LOADPAT "DEAD" SF 1

$ END OF MODEL FILE
