$ File template W2 viga compuesta cantilever — para que el usuario edite

$ PROGRAM INFORMATION
  PROGRAM  "ETABS"  VERSION "22.6.0"

$ CONTROLS
  UNITS  "kN"  "m"  "C"
  TITLE1  "W2 Viga Compuesta Cantilever — Template"
  TITLE2  "Edita seccion I + losa colaborante como prefieras"
  PREFERENCE  MERGETOL 0.1

$ STORIES - IN SEQUENCE FROM TOP
  STORY "Story1"  HEIGHT 3 MASTERSTORY "Yes"
  STORY "Base"  ELEV 0

$ MATERIAL PROPERTIES
  MATERIAL  "Steel_A572Gr50"    TYPE "Steel"    GRADE "Grade 50"    WEIGHTPERVOLUME 76.97
  MATERIAL  "Steel_A572Gr50"    SYMTYPE "Isotropic"  E 200000000  U 0.3  A 0.0000117
  MATERIAL  "Steel_A572Gr50"    FY 345000  FU 450000  FYE 379500  FUE 495000
  MATERIAL  "Conc_25MPa"        TYPE "Concrete" WEIGHTPERVOLUME 23.56
  MATERIAL  "Conc_25MPa"        SYMTYPE "Isotropic"  E 24980000  U 0.2  A 0.00001
  MATERIAL  "Conc_25MPa"        FC 25000

$ FRAME SECTIONS
  FRAMESECTION  "I_Custom"  MATERIAL "Steel_A572Gr50"  SHAPE "Steel I/Wide Flange"  D 0.3  B 0.15  TF 0.0107  TW 0.0071

$ POINT COORDINATES
  POINT "1"  0 0
  POINT "2"  3 0

$ LINE CONNECTIVITIES
  LINE  "B1"  BEAM  "1"  "2"  0

$ POINT ASSIGNS
  POINTASSIGN  "1"  "Story1"  RESTRAINT "UX UY UZ RX RY RZ"

$ LINE ASSIGNS
  LINEASSIGN  "B1"  "Story1"  SECTION "I_Custom"  MINNUMSTA 3 AUTOMESH "YES"  MESHATINTERSECTIONS "YES"

$ LOAD PATTERNS
  LOADPATTERN "Dead"  TYPE  "Dead"  SELFWEIGHT  1

$ LOAD CASES
  LOADCASE "Dead"  TYPE  "Linear Static"  INITCOND  "PRESET"
  LOADCASE "Dead"  LOADPAT  "Dead"  SF 1
  LOADCASE "Modal"  TYPE  "Modal - Eigen"  INITCOND  "PRESET"
  LOADCASE "Modal"  MAXMODES 3  MINMODES 1  EIGENSHIFTFREQ 0  EIGENCUTOFFFREQ 0  EIGENTOL 1E-09  ALLOWAUTOFREQSHIFT "Yes"

  END
$ END OF MODEL FILE
