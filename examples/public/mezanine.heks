# el AREA como objeto, que es como la guarda ETABS: un solo
# objeto de 4 esquinas que el malla por dentro. Hekatan
# resuelve con las 90 celdas, pero al exportar el e2k sale 1
# area, no 90. Sin esto el modelo reimportado traia la malla
# congelada y ya no se podia remallar ni mover el borde.
areaobj 1 2 10 12 4 1 90

# eje local 1 a 90 grados: el deck salva PERPENDICULAR a las
# viguetas y les entrega a ellas. No cambia el calculo de
# Hekatan (el reparto sale de la malla), pero ETABS lo
# necesita y sin el el e2k exportado no coincide.
shellang 1 90
